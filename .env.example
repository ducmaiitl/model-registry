# Postgres — MLflow backend store (metadata: models, versions, aliases, metrics)
PG_USER=mlflow
PG_PASSWORD=mlflow
PG_DB=mlflow

# GCS — artifact store (the actual weight files). Create the bucket once:
#   gcloud storage buckets create gs://<bucket> --location=asia-southeast1 --uniform-bucket-level-access
# The MLflow server needs roles/storage.objectAdmin on it (via the VM's
# service account on GCE, or a key file referenced below when off-GCP).
GOOGLE_CLOUD_PROJECT=ai-robotics-496803
GCS_BUCKET=robo-model-registry
# Leave empty on a GCE VM (ADC via the attached service account).
GOOGLE_APPLICATION_CREDENTIALS=

# Host port for the MLflow server. Never expose it publicly — no auth.
MLFLOW_PORT=5000

# Client-side: where consumers reach the registry. Clients need only this;
# artifacts are proxied by the server, so no GCS credentials on consumers.
MLFLOW_TRACKING_URI=http://localhost:5000

# HuggingFace read token — used only by scripts/register_from_hf.py.
HF_TOKEN=
