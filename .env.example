# Postgres — MLflow backend store (metadata: models, versions, aliases, metrics)
PG_USER=mlflow
PG_PASSWORD=mlflow
PG_DB=mlflow

# MinIO — artifact store (the actual weight files)
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MLFLOW_BUCKET=mlflow-artifacts

# Host ports. Override these if something else on this machine already uses
# 5000/9000/9001 (e.g. another MLflow stack). Container-internal ports never
# change, so only these and the two URLs below need adjusting.
MLFLOW_PORT=5000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Client-side: where consumers reach the registry
MLFLOW_TRACKING_URI=http://localhost:5000

# S3 access. The MLflow server runs with --serve-artifacts, so it proxies
# artifact up/download and clients normally do NOT need these. Set them only if
# you point a client straight at MinIO instead of through the server.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
